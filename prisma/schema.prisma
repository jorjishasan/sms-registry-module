// SMS Registry — data model (enrolment, fees, assessments, results)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enrolment ---

enum StudentStatus {
  ENROLLED
  DEFERRED
  WITHDRAWN
  COMPLETED
}

model Programme {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  baseFee   Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]
}

model Student {
  id           String        @id @default(cuid())
  studentId    String        @unique
  fullName     String
  email        String        @unique
  dateOfBirth  DateTime
  academicYear String
  status       StudentStatus @default(ENROLLED)
  programmeId  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  programme    Programme     @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  payments     Payment[]
  submissions  Submission[]
  grades       Grade[]

  @@index([programmeId])
  @@index([status])
  @@index([fullName])
  @@index([studentId])
}

// --- Fees ---

model Payment {
  id              String   @id @default(cuid())
  studentId       String
  amount          Float
  paymentDate     DateTime
  referenceNumber String   @unique
  createdAt       DateTime @default(now())
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// --- Assessments ---

model Assessment {
  id          String       @id @default(cuid())
  title       String
  moduleCode  String
  deadline    DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]
  grades      Grade[]

  @@index([moduleCode])
  @@index([deadline])
}

model Submission {
  id           String     @id @default(cuid())
  assessmentId String
  studentId    String
  fileName     String
  fileUrl      String
  submittedAt  DateTime   @default(now())
  isLate       Boolean    @default(false)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

// --- Results ---

enum GradeClassification {
  PASS
  MERIT
  DISTINCTION
  FAIL
}

model Grade {
  id             String              @id @default(cuid())
  assessmentId   String
  studentId      String
  score          Int
  classification GradeClassification
  isPublished    Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  assessment     Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([isPublished])
}
